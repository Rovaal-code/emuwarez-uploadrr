# .env.example — Variables de entorno para docker compose
# Copia a .env y ajusta antes de lanzar el contenedor.
# No metas API keys aquí. Configúralas desde el setup web (http://localhost:9494).

# UID/GID del usuario del sistema propietario de los archivos de media
PUID=1000
PGID=1000

# Zona horaria
TZ=Europe/Madrid

# Puerto de acceso al frontend/API
EMUWAREZ_UPLOADRR_PORT=9494

# Tag de la imagen publicada en ghcr.io/rovaal-code/emuwarez-uploadrr
# usada por docker-compose.yml (no aplica a docker-compose.example.yml,
# que construye la imagen localmente).
EMUWAREZ_UPLOADRR_TAG=latest

# Uploadrr-EMU va empaquetado dentro de la imagen — no hay nada que
# configurar aquí para él. Su config.yaml y sus temporales de subida
# persisten automáticamente bajo /config/Uploadrr (dentro del volumen
# de /config de arriba).
