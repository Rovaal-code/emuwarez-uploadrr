        "color": "blue",
        "phase": 4
      },
      "downloading": {
        "label": "Descargando",
        "color": "blue",
        "phase": 4
      },
      "pending_import": {
        "label": "Pendiente de importación",
        "color": "yellow",
        "phase": 4
      },
      "import_error": {
        "label": "Error de importación",
        "color": "red",
        "phase": 4
      },
      "search_error": {
        "label": "Error de búsqueda",
        "color": "red",
        "phase": 4
      },
      "uploading": {
        "label": "Subiendo",
        "color": "purple",
        "phase": 0
      },
      "uploaded": {
        "label": "Subido",
        "color": "green",
        "phase": 0
      },
      "error": {
        "label": "Error",
        "color": "red",
        "phase": 0
      },
      "unknown": {
        "label": "Desconocido",
        "color": "gray",
        "phase": 0
      }
    },
    "request_status": {
      "none": {
        "label": "Sin petición",
        "color": "gray"
      },
      "compatible": {
        "label": "Compatible",
        "color": "green"
      },
      "partial": {
        "label": "Parcial",
        "color": "yellow"
      },
      "not_compatible": {
        "label": "No compatible",
        "color": "orange"
      },
      "filled": {
        "label": "Llena",
        "color": "gray-light"
      },
      "active_unmatched": {
        "label": "Petición activa sin coincidencia",
        "color": "blue"
      },
      "unknown": {
        "label": "Desconocida",
        "color": "gray"
      }
    },
    "nomenclature_status": {
      "correct": {
        "label": "Correcta",
        "color": "green"
      },
      "not_adapted": {
        "label": "No adaptada",
        "color": "yellow"
      },
      "not_applicable": {
        "label": "N/A",
        "color": "gray"
      },
      "unknown": {
        "label": "Desconocida",
        "color": "gray"
      }
    },
    "emu_existence_status": {
      "not_checked": {
        "label": "No comprobado",
        "color": "gray"
      },
      "exists": {
        "label": "Existe en eMuwarez",
        "color": "blue"
      },
      "not_exists": {
        "label": "No existe en eMuwarez",
        "color": "gray-light"
      },
      "possible_duplicate": {
        "label": "Posible duplicado",
        "color": "yellow"
      },
      "duplicate_confirmed": {
        "label": "Duplicado confirmado",
        "color": "orange"
      },
      "unknown": {
        "label": "Desconocido",
        "color": "gray"
      }
    }
  },
  "recommended_actions": {
    "none": {
      "label": "Nada que hacer"
    },
    "wait_download": {
      "label": "Esperar descarga",
      "condition": "local_status in [queued, downloading]"
    },
    "review_arr": {
      "label": "Revisar Radarr/Sonarr",
      "condition": "local_status in [import_error, search_error]"
    },
    "check_emu": {
      "label": "Comprobar en EMU",
      "condition": "local_status=missing, no queue, no error"
    },
    "adapt_nomenclature": {
      "label": "Adaptar nomenclatura",
      "condition": "available + compatible/partial + not_adapted"
    },
    "upload": {
      "label": "Subir",
      "condition": "available + compatible + correct"
    },
    "create_emu_request": {
      "label": "Crear petición en eMuwarez",
      "condition": "missing + no queue + not exists in emu",
      "stub": true
    },
    "open_emu": {
      "label": "Abrir en eMuwarez"
    },
    "open_arr": {
      "label": "Abrir en Radarr/Sonarr"
    },
    "view_progress": {
      "label": "Ver progreso",
      "condition": "local_status=uploading"
    }
  },
  "compatibility_rules": {
    "matching_priority": [
      "tmdb_id",
      "imdb_id",
      "tvdb_id",
      "spanish_title_normalized + year",
      "original_title_normalized + year",
      "title_normalized (no year)",
      "fuzzy_fallback (no auto-action)"
    ],
    "result_values": [
      "compatible",
      "partial",
      "not_compatible",
      "filled"
    ],
    "any_means_no_restriction": true,
    "filled_overrides_all": true
  },
