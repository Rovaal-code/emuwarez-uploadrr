  "ui_style": {
    "theme": "dark",
    "background": "#0a0d14",
    "card_surface": "rgba(255,255,255,0.04)",
    "border": "1px solid rgba(59,130,246,0.15)",
    "border_radius": {
      "card": "8px",
      "badge": "6px",
      "input": "4px"
    },
    "typography": "Inter, system-ui, sans-serif",
    "colors": {
      "green": "#22c55e",
      "red": "#ef4444",
      "yellow": "#f59e0b",
      "purple": "#a855f7",
      "blue": "#3b82f6",
      "gray": "#6b7280"
    },
    "sidebar_width": "240px",
    "topbar_height": "56px",
    "grid_columns": 12,
    "gap": "16px",
    "naming_rules": {
      "use": [
        "Nomenclatura",
        "Adaptar nomenclatura",
        "Petición",
        "Compatible",
        "Parcial",
        "No compatible",
        "Llena",
        "Sin petición"
      ],
      "never_use": [
        "FormatoEMU",
        "Añadir formatoEMU"
      ]
    },
    "icon_rule": "Radarr and Sonarr must always show icon + text, never text alone"
  },
  "docker": {
    "default_port": 9494,
    "healthcheck_endpoint": "/api/health",
    "env_vars": {
      "PORT": "9494",
      "CONFIG_DIR": "/config",
      "TZ": "Europe/Madrid",
      "PUID": "1000 (optional)",
      "PGID": "1000 (optional)"
    },
    "volumes": {
      "/config": "configuration and SQLite database",
      "/media": "access to local media files",
      "/uploads": "hardlinks and upload staging",
      "/app/Uploadrr": "Uploadrr engine (external mount, not bundled)"
    }
  },
  "future_stubs": [
    {
      "id": "create_emu_request",
      "description": "Crear petición en eMuwarez",
      "reason": "Endpoint POST real de eMuwarez pendiente de capturar desde DevTools > Network",
      "current_behavior": "Devuelve { ok: false, stub: true, message: '...' }",
      "activation": "Cuando el usuario proporcione: URL endpoint, método, headers, payload y respuesta esperada"
    },
    {
      "id": "check_emu_existence",
      "description": "Comprobar si el contenido ya existe en eMuwarez",
      "reason": "Endpoint de búsqueda de eMuwarez pendiente de confirmar",
      "current_behavior": "emu_existence_status = not_checked"
    }
  ],
  "phase_9b_e2e": {
    "description": "Phase 9B adds a controlled Docker E2E demo. No new API endpoints.",
    "new_endpoints": [],
    "new_cli_commands": [
      "demo seed --media-root <path> --prepared-root <path> --confirm DEMO_SEED",
      "demo reset --confirm DEMO_RESET"
    ],
    "new_scripts": [
      "scripts/docker-e2e-demo.sh"
    ],
    "new_services": [
      "emuwarez_uploadrr/services/demo_seed.py"
    ],
    "isolation": "All demo data is seeded in a temporary CONFIG_DIR. No real APIs used."
  },
  "phase_10a_editable_nomenclature": {
    "description": "Phase 10A adds editable nomenclature fields, source/provider assistant and internal MKV title control.",
    "schema_version": 12,
    "provider_sources": [
      "WEB-DL"
    ],
    "mkv_confirmation_token": "APLICAR_TITULO_MKV",
    "new_endpoints": [
      {
        "method": "GET",
        "path": "/api/nomenclature/sources",
        "auth": true,
        "description": "List EMU sources"
      },
      {
        "method": "GET",
        "path": "/api/nomenclature/providers",
        "auth": true,
        "description": "List EMU providers"
      },
      {
        "method": "GET",
        "path": "/api/library/{id}/nomenclature/fields",
        "auth": true,
        "description": "Get editable fields for item"
      },
      {
        "method": "POST",
        "path": "/api/library/{id}/nomenclature/preview-fields",
        "auth": true,
        "description": "Preview with edited fields"
      },
      {
        "method": "POST",
        "path": "/api/library/{id}/nomenclature/save-fields",
        "auth": true,
        "description": "Save fields and create proposal"
      },
      {
        "method": "GET",
        "path": "/api/library/{id}/mkv-title/preview",
        "auth": true,
        "description": "Preview MKV title to apply"
      },
      {
        "method": "POST",
        "path": "/api/library/{id}/mkv-title/apply",
        "auth": true,
        "description": "Apply MKV title (requires confirmation token)"
      }
    ],
    "new_cli_commands": [
      "nomenclature sources",
      "nomenclature providers",
      "nomenclature fields <id>",
      "nomenclature preview-fields <id> --fields-json <json>",
      "mkv-title preview <id>",
      "mkv-title apply <id> [--apply --confirm APLICAR_TITULO_MKV]"
    ],
    "new_frontend_components": [
      "frontend/src/components/NomenclatureFieldsModal.tsx"
    ],
    "new_services": [
      "emuwarez_uploadrr/services/source_assistant.py",
      "emuwarez_uploadrr/services/mkv_title.py",
      "emuwarez_uploadrr/integrations/tmdb.py"
    ],
    "isolation": "mkvpropedit not called without token. TMDb non-blocking. No Uploadrr execution."
  },
  "phase_10c_integration_tests": {
    "description": "Phase 10C adds read-only connection test buttons for TMDb, eMuwarez, Radarr and Sonarr. Uploadrr is explicitly excluded.",
    "excluded_services": [
      "uploadrr"
    ],
    "new_endpoints": [
      {
        "method": "POST",
        "path": "/api/integrations/test/tmdb",
        "auth": true,
        "description": "Test a TMDb API key (provided or stored), read-only"
      },
      {
        "method": "POST",
        "path": "/api/integrations/test/emuwarez",
        "auth": true,
        "description": "Test eMuwarez credentials (provided or stored), read-only"
      },
      {
        "method": "POST",
        "path": "/api/integrations/test/arr",
        "auth": true,
        "description": "Test Radarr/Sonarr via saved instance_id or unsaved kind/base_url/api_key, read-only"
      }
    ],
    "result_shape": {
      "ok": "bool",
      "service": "string",
      "status": "string",
      "message": "string",
      "details": "object"
    },
    "statuses": [
      "connected",
      "not_configured",
      "invalid_key",
      "connection_error",
      "timeout",
      "invalid_url",
      "invalid_kind",
      "unexpected_error"
    ],
    "safety_guarantees": [
      "Read-only operations only",
      "Credentials sent for testing are never persisted",
      "API keys never returned or logged in full",
      "No eMuwarez requests created, no torrents uploaded",
      "Uploadrr has no code or endpoint in this module"
    ]
  }
}
