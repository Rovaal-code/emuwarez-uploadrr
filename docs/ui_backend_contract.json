{
  "product": {
    "name": "eMuwarez Uploadrr",
    "version": "0.2.0",
    "description": "Aplicación web + CLI para cruzar biblioteca Radarr/Sonarr con peticiones eMuwarez, detectar compatibilidad, adaptar nomenclatura y subir con Uploadrr.",
    "integrations": {
      "radarr": {
        "role": "primary_library_source",
        "required": true
      },
      "sonarr": {
        "role": "primary_library_source",
        "required": true
      },
      "tmdb": {
        "role": "enrichment_matching",
        "required": false,
        "recommended": true
      },
      "emuwarez": {
        "role": "requests_source_and_upload_destination",
        "required": true
      },
      "uploadrr": {
        "role": "upload_engine",
        "required": true,
        "external": true
      },
      "jellyfin": {
        "role": "optional_verification",
        "required": false
      },
      "seerr": {
        "role": "optional_context",
        "required": false
      }
    }
  },
  "sections": [
    {
      "id": "dashboard",
      "label": "Dashboard",
      "purpose": "Vista general del estado del sistema",
      "cli_equivalent": [
        "sync",
        "tasks list",
        "requests sync"
      ]
    },
    {
      "id": "library",
      "label": "Biblioteca",
      "purpose": "Todo el contenido conocido desde Radarr/Sonarr",
      "cli_equivalent": [
        "library list",
        "library show",
        "prepare",
        "upload"
      ]
    },
    {
      "id": "missing",
      "label": "Faltantes",
      "purpose": "Contenido monitorizado sin archivo local o con problemas. Origen: Radarr/Sonarr.",
      "cli_equivalent": [
        "missing list",
        "missing create-request"
      ]
    },
    {
      "id": "requests",
      "label": "Peticiones",
      "purpose": "Peticiones de eMuwarez ordenadas por capacidad de cubrirlas. Origen: eMuwarez.",
      "cli_equivalent": [
        "requests list",
        "requests sync",
        "requests show",
        "requests match"
      ]
    },
    {
      "id": "uploads",
      "label": "Subidas",
      "purpose": "Jobs de subida activos e histórico",
      "cli_equivalent": [
        "upload"
      ]
    },
    {
      "id": "tasks",
      "label": "Tareas",
      "purpose": "Historial de tareas ejecutadas",
      "cli_equivalent": [
        "tasks list"
      ]
    },
    {
      "id": "instances",
      "label": "Instancias",
      "purpose": "Gestión de instancias Radarr/Sonarr/Jellyfin/Seerr",
      "cli_equivalent": [
        "instances list",
        "instances add",
        "instances test",
        "instances remove"
      ]
    },
    {
      "id": "logs",
      "label": "Logs",
      "purpose": "Logs del sistema",
      "cli_equivalent": [
        "logs"
      ]
    },
    {
      "id": "settings",
      "label": "Configuración",
      "purpose": "Configuración general, credenciales y opciones",
      "cli_equivalent": [
        "configure"
      ]
    }
  ],
  "statuses": {
